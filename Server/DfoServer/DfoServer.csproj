<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>DfoServer</AssemblyName>
  </PropertyGroup>
  <!-- 独立发行保留 DLL 命令入口，只移除本机可执行外壳。 -->
  <PropertyGroup Condition="'$(ServerDllPackage)' == 'true'">
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Tools/ArchitectureCheck/ArchitectureCheck.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../../Tools/PvfLib/PvfLib.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <EmbeddedResource Include="GmWeb/recharge.html" LogicalName="DfoServer.GmWeb.%(Filename)%(Extension)" />
    <EmbeddedResource Include="GmWeb/client/*" LogicalName="DfoServer.GmWeb.client.%(Filename)%(Extension)" />
    <EmbeddedResource Include="SelfTests/Fixtures/luke-scene-contract-vectors.json" LogicalName="DfoServer.SelfTests.LukeSceneContractVectors" />
    <EmbeddedResource Include="SelfTests/Fixtures/promotion-page-contract-vectors.json" LogicalName="DfoServer.SelfTests.PromotionPageContractVectors" />
    <EmbeddedResource Include="Resources/channel.txt" LogicalName="DfoServer.Resources.channel.txt" />
    <EmbeddedResource Include="Resources/independent-attribute-pairs.json" LogicalName="DfoServer.Resources.independent-attribute-pairs.json" />
    <EmbeddedResource Include="Resources/cash-shop-promotions.json" LogicalName="DfoServer.Resources.cash-shop-promotions.json" />
    <EmbeddedResource Include="Sqlite/game_schema.sql" LogicalName="DfoServer.Sqlite.game_schema.sql" />
    <None Update="Resources/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Sqlite/*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data/Pvf/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data/Pvf/*" CopyToPublishDirectory="Never" Condition="'$(BundleServer)' == 'true'" />
    <None Update="Data/DisplayCompat.world.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../start-server.bat;../../start-server.sh" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(ServerDllPackage)' == 'true'">
    <None Update="Resources/**;Sqlite/*.sql;Data/**;../../start-server.bat;../../start-server.sh" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
